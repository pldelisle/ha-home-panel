{
  "name": "ha-home-panel",
  "version": "2.11.1",
  "description": "A wall-tablet and phone dashboard for Home Assistant, installed as a custom sidebar panel",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "npm run build && playwright test",
    "check": "node --check dist/home-panel.js",
    "test:e2e:old": "node test/e2e/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}

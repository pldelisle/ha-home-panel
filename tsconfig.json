{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["*.ts", "src/**/*.ts", "test/**/*.ts"],
  // loose-pass scaffolding for the legacy files: tsconfig.legacy.json only
  "exclude": ["src/legacy/**/*.d.ts"]
}

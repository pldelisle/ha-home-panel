{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    // the tests import a few .mjs helpers and the French layer (src/i18n/fr.js), phase 4's input
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "src/**/*.ts", "test/**/*.ts"]
}

{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/env.d.ts",
    "src/core/**/*.ts",
    "src/providers/**/*.ts",
    "src/features/**/*.ts",
    "src/shell/**/*.ts",
    "src/ui/**/*.ts"
  ]
}
